{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furlong-club",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["notifications@furlong.club"] }],
  "routes": [
    { "pattern": "furlong.club", "custom_domain": true },
    { "pattern": "www.furlong.club", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (DATABASE_URL, AUTH_SECRET, CRON_SECRET, RESEND_API_KEY, ...) are pushed by the deploy workflow.
  "vars": {
    "CLUB_GATE_ENABLED": "true",
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM_ADDRESS": "notifications@furlong.club",
    "APP_URL": "https://furlong.club",
    "DATABASE_DRIVER": "neon-http",
    "APP_ENV": "production",
    "ENABLE_TEST_PAYMENTS": "false",
    "PAYMENT_PROVIDER": "nowpayments",
    "DEPOSIT_MODE": "manual",
    "WALLET_ENABLED": "true",
    "TRADING_REQUESTS_ENABLED": "false"
  }
}
