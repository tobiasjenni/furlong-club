# Postgres connection
DATABASE_URL="postgresql://horse:horse@localhost:5432/horse?schema=public"

# Long random string, e.g. `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used for payment callbacks)
APP_URL="http://localhost:3000"

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Payment provider: "mock" (local testing) or "nowpayments"
PAYMENT_PROVIDER="mock"
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_SANDBOX="true"

# Wallet deposits/withdrawals stay off until licensing and KYC are in place
WALLET_ENABLED="false"
