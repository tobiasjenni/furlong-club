# Postgres connection
DATABASE_URL="postgresql://horse:horse@localhost:5432/furlong?schema=public"

# Long random string, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used in emails and payment callbacks)
APP_URL="http://localhost:3000"

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Payment provider: "mock" (local testing only) or "nowpayments"
PAYMENT_PROVIDER="mock"
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_SANDBOX="true"

# Email: sends through resend.com when RESEND_API_KEY is set; otherwise emails are printed to the server log
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Furlong Club <no-reply@furlong.club>"

# Bunny Stream: library ID and the "Token authentication key" from the library's Security settings
BUNNY_LIBRARY_ID=""
BUNNY_TOKEN_KEY=""

# Bearer token for /api/cron/daily (renewal reminders, expiring payments). Vercel sends it automatically.
CRON_SECRET=""

# Enable member USD credit top-ups and balance purchases only after provider + pooled wallets are set.
WALLET_ENABLED="false"
DEPOSIT_MODE="manual"
# Public receiving addresses only. Never configure a private key/seed phrase here.
POOL_WALLET_USDC_POLYGON=""
POOL_WALLET_USDT_TRC20=""
# Optional Ethereum alternatives (usually higher network fees)
POOL_WALLET_USDC_ERC20=""
POOL_WALLET_USDT_ERC20=""
